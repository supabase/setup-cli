# Default all repository changes to the CLI team.
* @supabase/cli

# Files that Dependabot updates. Either owner satisfies code-owner review; `supabase-oss`
# approves only Dependabot PRs, through dependabot.yml.
/.github/workflows/*.yml @supabase/cli @supabase-oss
/action.yml @supabase/cli @supabase-oss
/package.json @supabase/cli @supabase-oss
/bun.lock @supabase/cli @supabase-oss

# Dependabot PRs touching this workflow still need a maintainer: it runs with secrets.
# Last matching pattern wins.
/.github/workflows/dependabot.yml @supabase/cli
