{
  "name": "setup-cli",
  "version": "3.0.0",
  "private": true,
  "description": "Supabase CLI GitHub Action",
  "keywords": [
    "actions"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supabase/setup-cli.git"
  },
  "type": "module",
  "scripts": {
    "all": "pnpm run format && pnpm run lint && pnpm run build && pnpm run coverage",
    "build": "rolldown -c",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run coverage",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "format": "oxfmt --write . '!coverage/**' '!dist/**'",
    "format:check": "oxfmt --check . '!coverage/**' '!dist/**'",
    "lint": "oxlint --deny-warnings --type-aware --type-check --tsconfig tsconfig.json src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "js-yaml": "^5.5.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^0.24.0",
    "rolldown": "^1.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "error"
    }
  }
}
